// Traveloop Prisma Schema — PRD §6 source of truth
// All 10 tables + soft delete + all indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  city         String?  @db.VarChar(100)
  country      String?  @db.VarChar(100)
  passwordHash String   @map("password_hash")
  profilePhoto String?  @map("profile_photo")
  bio          String?
  role         String   @default("user") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  trips          Trip[]
  communityPosts CommunityPost[]

  @@map("users")
}

model Trip {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?
  coverPhoto  String?   @map("cover_photo")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  totalBudget Decimal?  @map("total_budget") @db.Decimal(12, 2)
  status      String    @default("planned") @db.VarChar(20)
  isPublic    Boolean   @default(false) @map("is_public")
  publicSlug  String?   @unique @map("public_slug") @db.VarChar(100)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections       TripSection[]
  budgetItems    BudgetItem[]
  packingItems   PackingItem[]
  notes          TripNote[]
  invoices       Invoice[]
  communityPosts CommunityPost[]

  @@index([userId])
  @@index([status])
  @@map("trips")
}

model City {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(100)
  country        String   @db.VarChar(100)
  region         String?  @db.VarChar(100)
  coverPhoto     String?  @map("cover_photo")
  costIndex      String?  @map("cost_index") @db.VarChar(20)
  popularityRank Int?     @map("popularity_rank")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  activities   Activity[]
  tripSections TripSection[]

  @@index([name])
  @@map("cities")
}

model Activity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId      String   @map("city_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  category    String?  @db.VarChar(100)
  avgCost     Decimal? @map("avg_cost") @db.Decimal(10, 2)
  durationHrs Decimal? @map("duration_hrs") @db.Decimal(4, 1)
  coverPhoto  String?  @map("cover_photo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  city               City              @relation(fields: [cityId], references: [id])
  sectionActivities  SectionActivity[]

  @@index([cityId])
  @@map("activities")
}

model TripSection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  cityId      String?  @map("city_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  budget      Decimal? @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip       Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City?             @relation(fields: [cityId], references: [id])
  activities SectionActivity[]
  notes      TripNote[]

  @@index([tripId])
  @@map("trip_sections")
}

model SectionActivity {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId     String    @map("section_id") @db.Uuid
  activityId    String    @map("activity_id") @db.Uuid
  dayNumber     Int?      @map("day_number")
  scheduledTime String?   @map("scheduled_time") @db.VarChar(10)
  actualCost    Decimal?  @map("actual_cost") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  section  TripSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  activity Activity    @relation(fields: [activityId], references: [id])

  @@map("section_activities")
}

model BudgetItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  sectionId   String?  @map("section_id") @db.Uuid
  category    String?  @db.VarChar(100)
  description String   @db.VarChar(255)
  qty         Decimal  @default(1) @db.Decimal(8, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("budget_items")
}

model Invoice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  invoiceNumber String    @unique @map("invoice_number") @db.VarChar(50)
  generatedAt   DateTime  @default(now()) @map("generated_at") @db.Timestamptz()
  subtotal      Decimal?  @db.Decimal(12, 2)
  taxRate       Decimal   @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal?  @map("tax_amount") @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal?  @map("grand_total") @db.Decimal(12, 2)
  paymentStatus String    @default("pending") @map("payment_status") @db.VarChar(20)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz()
  travelerIds   String[]  @map("traveler_ids") @db.Uuid

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model PackingItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  category  String?  @db.VarChar(100)
  itemName  String   @map("item_name") @db.VarChar(255)
  isPacked  Boolean  @default(false) @map("is_packed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("packing_items")
}

model TripNote {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  sectionId String?   @map("section_id") @db.Uuid
  dayNumber Int?      @map("day_number")
  title     String?   @db.VarChar(255)
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  section TripSection? @relation(fields: [sectionId], references: [id])

  @@index([tripId])
  @@map("trip_notes")
}

model CommunityPost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  caption   String?
  viewCount Int      @default(0) @map("view_count")
  copyCount Int      @default(0) @map("copy_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("community_posts")
}
